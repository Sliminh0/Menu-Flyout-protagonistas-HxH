<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Menu_Flyout_protagonistas_HxH.Kurapika"
             Title="Kurapika"
              BackgroundColor="#3b3d3b">
<VerticalStackLayout Padding="20" Spacing="20">
        <Image
                Source="killuaa.jpg"
                HeightRequest="220"
                Aspect="AspectFill" />


        <Border
                Stroke="#3c9151"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 12"
                Padding="15" BackgroundColor="#2A753C">

            <Label 
            Text="Kurapika é o último sobrevivente do Clã Kurta. Ele é um Caçador da Lista Negra e o atual subchefe da organização fundada por Light Nostrade. Ele é membro dos Zodíacos com o codinome Rato. Seu objetivo é vingar seu clã e recuperar os Olhos Escarlates restantes. Ele assume o papel de protagonista principal nos arcos de Yorknew City e da Disputa pela Sucessão. Ele também foi o deuteragonista no arco do Exame Hunter."
            />

        </Border>

        <HorizontalStackLayout Padding="20" Spacing="15">

            <Image Source="kurapikaaaaaaaaaaaaaaa.jpg"
                   HeightRequest="100"
                   Aspect="AspectFill"
                   WidthRequest="100"/>

            <Image Source="kurapikabravo.jpg"
                   HeightRequest="100"
                   Aspect="AspectFill"
                   WidthRequest="100"/>

            <Image Source="kurapikaa.jpg"
                   HeightRequest="100"
                   Aspect="AspectFill"
                   WidthRequest="100"/>
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>
